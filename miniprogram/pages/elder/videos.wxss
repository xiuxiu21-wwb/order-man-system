page { background: #111827; }

.video-page { position: relative; width: 100%; height: 100vh; overflow: hidden; background: #111827; }
.video-swiper, .video-slide, .video-player, .video-poster { width: 100%; height: 100%; }
.video-slide { position: relative; overflow: hidden; background: #111827; }
.video-player { display: block; }
.video-poster { position: absolute; z-index: 2; inset: 0; display: block; pointer-events: none; }
.video-gradient { position: absolute; z-index: 3; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(17,24,39,.46) 0%, transparent 28%, transparent 54%, rgba(17,24,39,.9) 100%); }
.video-topbar { position: absolute; z-index: 4; top: calc(18rpx + env(safe-area-inset-top)); left: 24rpx; right: 24rpx; display: flex; align-items: center; justify-content: space-between; color: #fff; }
.video-back { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(17,24,39,.48); font-size: 58rpx; line-height: 1; }
.video-title { font-size: 30rpx; font-weight: 800; }
.video-count { min-width: 90rpx; padding: 12rpx 16rpx; border-radius: 24rpx; background: rgba(17,24,39,.48); font-size: 22rpx; text-align: center; }
.video-copy { position: absolute; z-index: 4; left: 30rpx; right: 150rpx; bottom: calc(118rpx + env(safe-area-inset-bottom)); color: #fff; }
.video-name { font-size: 38rpx; font-weight: 800; line-height: 1.35; }
.video-description { margin-top: 14rpx; font-size: 27rpx; line-height: 1.55; color: rgba(255,255,255,.9); }
.video-source { margin-top: 16rpx; color: rgba(255,255,255,.68); font-size: 22rpx; }
.video-actions { position: absolute; z-index: 4; right: 28rpx; bottom: calc(150rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 24rpx; align-items: center; color: #fff; font-size: 22rpx; }
.video-action { display: flex; flex-direction: column; align-items: center; gap: 8rpx; min-width: 76rpx; }
.video-action-circle { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(17,24,39,.58); border: 1rpx solid rgba(255,255,255,.5); border-radius: 50%; font-size: 28rpx; font-weight: 800; }
.video-action:active .video-action-circle { background: #ea580c; }
.video-hint { position: absolute; z-index: 4; bottom: calc(30rpx + env(safe-area-inset-bottom)); left: 0; right: 0; color: rgba(255,255,255,.72); font-size: 22rpx; text-align: center; }
.video-empty, .video-loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; }
.video-empty { background: #111827; }
.empty-title { font-size: 36rpx; font-weight: 800; }
.empty-copy { margin-top: 12rpx; color: #9ca3af; font-size: 26rpx; }
.video-loading { color: #d1d5db; background: #111827; font-size: 28rpx; }
