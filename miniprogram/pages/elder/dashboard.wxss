.page {
  background: #fff7ed;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx;
  position: relative;
  background: #fff7ed;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 450rpx;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  z-index: 0;
}

.header {
  position: relative;
  z-index: 1;
  margin-bottom: 40rpx;
}

.greeting-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  margin-bottom: 30rpx;
}

.greeting-text { flex: 1; }
.hello { margin-bottom: 4rpx; color: rgba(255,255,255,.9); font-size: 28rpx; }
.user-name { color: #fff; font-size: 48rpx; font-weight: 800; }
.date-badge {
  padding: 12rpx 24rpx;
  color: #fff;
  background: rgba(255,255,255,.2);
  border: 2rpx solid rgba(255,255,255,.3);
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.weather-card {
  position: relative;
  padding: 40rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, #fb923c 0%, #ea580c 100%);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(234,88,12,.25);
}

.weather-header { display: flex; align-items: flex-start; justify-content: space-between; }
.weather-main { display: flex; flex: 1; align-items: center; margin-bottom: 15rpx; }
.weather-icon { margin-right: 20rpx; font-size: 80rpx; }
.weather-info { flex: 1; }
.weather-temp { margin-bottom: 8rpx; font-size: 48rpx; font-weight: 700; line-height: 1; }
.weather-text { color: rgba(255,255,255,.9); font-size: 28rpx; }
.refresh-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.2);
  border: 2rpx solid rgba(255,255,255,.3);
  border-radius: 50%;
}
.refresh-icon-image { width: 44rpx; height: 44rpx; }
.weather-details {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,.2);
}
.detail-item { display: flex; flex-direction: column; align-items: center; }
.detail-label { margin-bottom: 6rpx; color: rgba(255,255,255,.8); font-size: 22rpx; }
.detail-value { font-size: 26rpx; font-weight: 600; }
.weather-location { margin-top: 10rpx; color: rgba(255,255,255,.8); font-size: 24rpx; text-align: right; }
.weather-forecast { padding-top: 20rpx; margin-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,.2); }
.forecast-title { margin-bottom: 15rpx; font-size: 26rpx; font-weight: 600; text-align: center; }
.forecast-list { display: flex; justify-content: space-around; }
.forecast-item { min-width: 140rpx; padding: 15rpx 10rpx; background: rgba(255,255,255,.1); border-radius: 12rpx; text-align: center; }
.forecast-date { margin-bottom: 8rpx; color: rgba(255,255,255,.8); font-size: 22rpx; }
.forecast-weather { margin-bottom: 6rpx; font-size: 24rpx; }
.forecast-temp { color: rgba(255,255,255,.9); font-size: 22rpx; }
.weather-loading, .weather-default { padding: 40rpx; margin-top: 30rpx; background: #f3f4f6; border-radius: 20rpx; text-align: center; }
.loading-spinner { margin-bottom: 15rpx; font-size: 60rpx; }
.loading-text, .weather-default .weather-text { color: #6b7280; font-size: 26rpx; }
.weather-default .weather-icon { margin: 0 0 10rpx; color: #9ca3af; font-size: 60rpx; }

.ai-care-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.ai-care-kicker { color: #ea580c; font-size: 22rpx; font-weight: 700; }
.ai-care-title { margin-top: 4rpx; color: #1f2937; font-size: 38rpx; font-weight: 800; }
.ai-care-status { display: inline-flex; padding: 10rpx 16rpx; margin-top: 22rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: 700; }
.ai-care-status.steady { color: #047857; background: #ecfdf5; }
.ai-care-status.attention { color: #b91c1c; background: #fef2f2; }
.ai-care-summary { margin-top: 24rpx; color: #374151; font-size: 28rpx; line-height: 1.7; }
.ai-care-loading { padding: 34rpx 0 12rpx; color: #78716c; font-size: 26rpx; }
.care-risk { padding: 22rpx 24rpx; margin-top: 24rpx; background: #fff1f2; border-radius: 16rpx; }
.care-risk-title { color: #b91c1c; font-size: 27rpx; font-weight: 800; }
.care-risk-text { margin-top: 8rpx; color: #7f1d1d; font-size: 24rpx; line-height: 1.6; }
.care-task-list { margin-top: 24rpx; border-top: 1rpx solid #f3f4f6; }
.care-task { display: flex; align-items: flex-start; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.care-task-mark { width: 54rpx; height: 54rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #c2410c; background: #fff7ed; border-radius: 14rpx; font-size: 23rpx; font-weight: 800; }
.care-task.overdue .care-task-mark { color: #b91c1c; background: #fef2f2; }
.care-task-copy { flex: 1; min-width: 0; }
.care-task-title { color: #1f2937; font-size: 28rpx; font-weight: 700; }
.care-task-detail { margin-top: 6rpx; color: #6b7280; font-size: 23rpx; line-height: 1.55; }
.ai-care-links { display: flex; gap: 12rpx; margin-top: 22rpx; }
.ai-care-link { flex: 1; padding: 18rpx 14rpx; color: #c2410c; background: #fff7ed; border-radius: 12rpx; font-size: 23rpx; font-weight: 700; text-align: center; }
.ai-care-disclaimer { margin-top: 18rpx; color: #9ca3af; font-size: 20rpx; line-height: 1.5; }

.quick-actions { display: grid; grid-template-columns: repeat(2,1fr); gap: 30rpx; margin-bottom: 50rpx; }
.action-card { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 50rpx 30rpx; overflow: hidden; background: #fff; border-radius: 30rpx; box-shadow: 0 8rpx 20rpx rgba(0,0,0,.08); }
.action-card:active { transform: scale(.96); }
.action-icon-image { width: 120rpx; height: 120rpx; margin-bottom: 20rpx; border-radius: 50%; }
.action-title { color: #1f2937; font-size: 30rpx; font-weight: 700; }
.action-card-voice .action-title { color: #7c3aed; }
.action-card-medication .action-title { color: #059669; }
.action-card-image .action-title { color: #2563eb; }
.action-card-map .action-title { color: #d97706; }
.action-card-news .action-title { color: #dc2626; }
.action-card-profile .action-title { color: #db2777; }
.action-card-videos .action-title { color: #0f766e; }
.action-card-camera .action-title { color: #1d4ed8; }
.video-action-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #14b8a6 0%, #0f766e 100%);
  border-radius: 50%;
  box-shadow: 0 10rpx 22rpx rgba(15,118,110,.2);
  font-size: 48rpx;
}
.camera-icon { background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%); box-shadow: 0 10rpx 22rpx rgba(37,99,235,.2); }

.emergency-section { margin-bottom: 50rpx; }
.emergency-btn { width: 100%; padding: 40rpx; color: #fff; background: linear-gradient(135deg,#ef4444 0%,#dc2626 100%); border: none; border-radius: 40rpx; font-size: 38rpx; font-weight: 800; }
.emergency-btn::after { border: none; }
.card { padding: 40rpx; margin-bottom: 40rpx; background: #fff; border-radius: 30rpx; box-shadow: 0 8rpx 24rpx rgba(251,146,60,.12); }
.card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.card-title { color: #1f2937; font-size: 34rpx; font-weight: 800; }
.dose-badge { padding: 8rpx 18rpx; color: #ea580c; background: #fff7ed; border: 1rpx solid #fed7aa; border-radius: 24rpx; font-size: 22rpx; font-weight: 700; }
.reminder-item { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx; margin-bottom: 16rpx; background: #fffaf5; border: 1rpx solid #ffedd5; border-radius: 24rpx; }
.reminder-item.completed { background: #f8fafc; border-color: #e2e8f0; }
.reminder-times-wrapper { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.reminder-time-pill { min-width: 120rpx; padding: 10rpx 16rpx; color: #ea580c; background: #fff; border: 1rpx solid #fed7aa; border-radius: 18rpx; font-size: 26rpx; font-weight: 700; text-align: center; }
.reminder-time-pill.taken { color: #16a34a; background: #dcfce7; border-color: #86efac; }
.reminder-content { flex: 1; }
.reminder-top { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 8rpx; }
.reminder-name { color: #1f2937; font-size: 30rpx; font-weight: 700; }
.reminder-name.completed { color: #94a3b8; }
.reminder-count { padding: 6rpx 14rpx; color: #b45309; background: #fef3c7; border-radius: 18rpx; font-size: 22rpx; font-weight: 700; }
.reminder-count.done { color: #059669; background: #d1fae5; }
.reminder-dosage { display: block; color: #6b7280; font-size: 24rpx; }
.completed-toggle { display: flex; justify-content: space-between; padding: 18rpx 22rpx; background: #f8fafc; border: 1rpx solid #e2e8f0; border-radius: 20rpx; }
.completed-toggle-text, .completed-toggle-arrow { color: #64748b; font-size: 24rpx; }
.completed-toggle-arrow { color: #94a3b8; }
.empty-reminder { padding: 40rpx 20rpx; text-align: center; }
.empty-text { margin-bottom: 10rpx; color: #9ca3af; font-size: 28rpx; }
.empty-hint { color: #d1d5db; font-size: 24rpx; }
.logout-section { margin-top: 40rpx; }
.logout-btn { width: 100%; padding: 24rpx; color: #6b7280; background: #f3f4f6; border: none; border-radius: 12rpx; font-size: 28rpx; }
.logout-btn::after { border: none; }

.floating-pet {
  position: fixed;
  right: 22rpx;
  bottom: 238rpx;
  z-index: 20;
  width: 464rpx;
  height: 420rpx;
  transition: transform 120ms ease-out;
}
.floating-pet:active { transform: scale(.96); }
.floating-pet.is-dragging { transition: none; }
.floating-pet.is-dragging .floating-pet-image { animation: none; }
.floating-pet.chat-open {
  right: 18rpx;
  bottom: 42rpx;
}
.pet-chat-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 18;
  background: rgba(47, 28, 14, .38);
  animation: pet-chat-overlay-in 220ms ease-out both;
}
@keyframes pet-chat-overlay-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
.pet-chat-panel {
  position: fixed;
  right: 34rpx;
  bottom: 300rpx;
  left: 34rpx;
  z-index: 22;
  width: auto;
  padding: 18rpx;
  box-sizing: border-box;
  background: #fffdf9;
  border: 2rpx solid #fed7aa;
  border-radius: 18rpx 18rpx 6rpx 18rpx;
  box-shadow: 0 20rpx 42rpx rgba(47,28,14,.32);
  animation: pet-chat-panel-in 240ms ease-out both;
}
@keyframes pet-chat-panel-in {
  from { opacity: 0; transform: translateY(18rpx) scale(.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.pet-chat-panel::after {
  position: absolute;
  right: 34rpx;
  bottom: -9rpx;
  width: 16rpx;
  height: 16rpx;
  content: '';
  background: #fffdf9;
  border-right: 2rpx solid #fed7aa;
  border-bottom: 2rpx solid #fed7aa;
  transform: rotate(45deg);
}
.pet-chat-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 10rpx; border-bottom: 1rpx solid #fde7d8; }
.pet-chat-title { color: #9a3412; font-size: 23rpx; font-weight: 800; }
.pet-chat-close { display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; color: #9a7467; font-size: 36rpx; line-height: 1; }
.pet-chat-messages { height: 340rpx; padding: 14rpx 2rpx; box-sizing: border-box; }
.pet-chat-message { max-width: 86%; padding: 10rpx 12rpx; margin-bottom: 10rpx; box-sizing: border-box; border-radius: 12rpx; color: #6b4a3d; font-size: 20rpx; line-height: 1.5; word-break: break-all; }
.pet-chat-message.pet { margin-right: auto; background: #fff1df; border-bottom-left-radius: 4rpx; }
.pet-chat-message.user { margin-left: auto; color: #ffffff; background: #f97316; border-bottom-right-radius: 4rpx; }
.pet-navigation-card { padding-top: 10rpx; margin-top: 10rpx; border-top: 1rpx solid #f7d5bd; }
.pet-navigation-name { color: #7c2d12; font-size: 20rpx; font-weight: 800; }
.pet-navigation-address, .pet-navigation-distance { margin-top: 5rpx; color: #8d5845; font-size: 18rpx; line-height: 1.4; }
.pet-navigation-button { display: flex; align-items: center; justify-content: center; height: 52rpx; margin-top: 10rpx; color: #ffffff; background: #f97316; border-radius: 8rpx; font-size: 19rpx; font-weight: 700; }
.pet-chat-typing { display: flex; align-items: center; gap: 6rpx; width: fit-content; padding: 14rpx 16rpx; background: #fff1df; border-radius: 12rpx; border-bottom-left-radius: 4rpx; }
.pet-chat-typing view { width: 8rpx; height: 8rpx; background: #f59e0b; border-radius: 50%; animation: pet-chat-dot 1s ease-in-out infinite; }
.pet-chat-typing view:nth-child(2) { animation-delay: .14s; }
.pet-chat-typing view:nth-child(3) { animation-delay: .28s; }
@keyframes pet-chat-dot { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
.pet-chat-input-row { display: flex; align-items: center; gap: 8rpx; padding-top: 12rpx; border-top: 1rpx solid #fde7d8; }
.pet-chat-voice { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; flex-shrink: 0; color: #9a7467; background: #fff7ed; border-radius: 50%; font-size: 24rpx; }
.pet-chat-voice.recording { color: #fff; background: #ef4444; }
.pet-chat-voice-hint { padding-top: 7rpx; color: #c2410c; font-size: 18rpx; text-align: center; }
.pet-chat-input { min-width: 0; flex: 1; height: 56rpx; padding: 0 14rpx; box-sizing: border-box; color: #5f4035; background: #fff7ed; border-radius: 10rpx; font-size: 20rpx; }
.pet-chat-placeholder { color: #c8a393; }
.pet-chat-send { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 56rpx; color: #c8a393; background: #f5e6dc; border-radius: 10rpx; font-size: 20rpx; font-weight: 700; }
.pet-chat-send.ready { color: #ffffff; background: #f97316; }
.floating-pet-bubble {
  position: absolute;
  left: 0;
  bottom: 86rpx;
  z-index: 2;
  width: 324rpx;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  color: #6b3b25;
  background: #fffdf9;
  border: 2rpx solid #fed7aa;
  border-radius: 16rpx 16rpx 4rpx 16rpx;
  box-shadow: 0 7rpx 13rpx rgba(124,45,18,.14);
}
.floating-pet-bubble::after {
  position: absolute;
  right: -7rpx;
  bottom: 18rpx;
  width: 13rpx;
  height: 13rpx;
  content: '';
  background: #fffdf9;
  border-top: 2rpx solid #fed7aa;
  border-right: 2rpx solid #fed7aa;
  transform: rotate(45deg);
}
.floating-pet-plan-title { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; color: #9a3412; font-size: 24rpx; font-weight: 800; }
.floating-pet-plan-status { flex-shrink: 0; padding: 3rpx 8rpx; color: #047857; background: #ecfdf5; border-radius: 8rpx; font-size: 17rpx; font-weight: 700; }
.floating-pet-plan-status.attention { color: #b91c1c; background: #fff1f2; }
.floating-pet-plan-summary { display: -webkit-box; margin-top: 7rpx; overflow: hidden; color: #765849; font-size: 19rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.floating-pet-plan-task { display: flex; align-items: center; gap: 7rpx; margin-top: 7rpx; overflow: hidden; }
.floating-pet-plan-dot { width: 8rpx; height: 8rpx; flex-shrink: 0; background: #f59e0b; border-radius: 50%; }
.floating-pet-plan-task-text { overflow: hidden; color: #8d5845; font-size: 18rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.floating-pet-plan-loading { padding: 12rpx 0 4rpx; color: #9a7467; font-size: 19rpx; }
.floating-pet-medication { padding-top: 10rpx; margin-top: 10rpx; border-top: 1rpx solid #fde7d8; }
.floating-pet-medication-title { color: #9a3412; font-size: 20rpx; font-weight: 800; }
.floating-pet-medication-row { display: flex; align-items: center; gap: 9rpx; margin-top: 6rpx; overflow: hidden; }
.floating-pet-medication-time { flex-shrink: 0; color: #c2410c; font-size: 18rpx; font-weight: 800; }
.floating-pet-medication-name { overflow: hidden; color: #8d5845; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.floating-pet-medication-empty { margin-top: 6rpx; color: #9a7467; font-size: 18rpx; }
.floating-pet-image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 132rpx;
  height: 184rpx;
  filter: drop-shadow(0 10rpx 12rpx rgba(124,45,18,.18));
  animation: floating-pet-drift 3.2s ease-in-out infinite;
}
@keyframes floating-pet-drift {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-8rpx) rotate(2deg); }
}
